<%- include('partials/head') %>

<body class="w-full min-h-screen bg-gradient-to-br from-slate-100 to-slate-200 text-gray-800">
  <%- include('partials/header') %>

  <main class="max-w-4xl mx-auto p-6 mt-12 bg-white rounded-3xl shadow-2xl">
    <div class="space-y-8">

      <% let photourl = home.photo; %>

      <!-- photo Section -->
      <% if (photourl) { %>
        <div class="w-full h-72 rounded-2xl overflow-hidden shadow-md">
          <img src="<%= photourl %>" alt="<%= home.homename %>" class="w-full h-full object-cover">
        </div>
      <% } else { %>
        <div class="w-full h-72 flex items-center justify-center bg-gray-200 rounded-2xl text-gray-500 text-lg italic">
          No photo available
        </div>
      <% } %>

      <!-- Home Information -->
      <div class="space-y-4">
        <div class="flex justify-between items-center border-b pb-3">
          <span class="text-lg text-gray-500 font-semibold">🏠 Name:</span>
          <span class="text-xl font-bold text-slate-700"><%= home.homename %></span>
        </div>

        <div class="flex justify-between items-center border-b pb-3">
          <span class="text-lg text-gray-500 font-semibold">📍 Location:</span>
          <span class="text-xl font-bold text-slate-700"><%= home.location %></span>
        </div>

        <div class="flex justify-between items-center border-b pb-3">
          <span class="text-lg text-gray-500 font-semibold">💰 Price:</span>
          <span class="text-xl font-bold text-green-600">₹<%= home.price %></span>
        </div>

        <!-- Description -->
        <div class="pt-4 border-t border-gray-200">
          <h2 class="text-lg font-semibold text-slate-800 mb-2">📝 Description:</h2>
          <p class="text-base text-gray-600 leading-relaxed whitespace-pre-line">
            <%= home.homescol || 'No description provided.' %>
          </p>
        </div>
      </div>
    </div>
  </main>
</body>
