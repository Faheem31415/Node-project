<%- include('partials/head') %>

<body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen font-sans">
    <%- include('partials/header') %>

    <div class="max-w-2xl mx-auto mt-10 p-10 bg-white shadow-2xl rounded-2xl border border-gray-100">
        <h1 class="text-4xl font-bold text-center mb-10 text-gray-800 relative">
            <%= editing ? "Edit Your Home" : "Add Your Home to Home Hub" %>
        </h1>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 rounded-lg bg-red-50 border border-red-300 text-red-700 text-sm">
          <%= error %>
        </div>
        <% } %>

        <form action="/host/<%= editing ? "edit-home" : "registered-home" %>" method="POST" enctype="multipart/form-data" class="space-y-8">
            <input type="hidden" name="id" value="<%= editing ? home._id : '' %>"/>

            <div class="transition-all duration-300 hover:scale-[1.01]">
                <label for="homename" class="block text-gray-700 font-semibold mb-2">Name:</label>
                <input value="<%= editing ? home.homename : '' %>" type="text" name="homename" id="homename" required
                    placeholder="Enter home name" class="w-full px-5 py-3 border border-gray-200 rounded-lg
                    focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition duration-200">
            </div>

            <div class="transition-all duration-300 hover:scale-[1.01]">
                <label for="location" class="block text-gray-700 font-semibold mb-2">Location:</label>
                <input value="<%= editing ? home.location : '' %>" type="text" name="location" id="location" required
                    placeholder="Enter location" class="w-full px-5 py-3 border border-gray-200 rounded-lg
                    focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition duration-200">
            </div>

            <div class="transition-all duration-300 hover:scale-[1.01]">
                <label for="price" class="block text-gray-700 font-semibold mb-2">Price (per night ₹):</label>
                <input value="<%= editing ? home.price : '' %>" type="number" name="price" id="price" required min="1"
                    placeholder="Enter price" class="w-full px-5 py-3 border border-gray-200 rounded-lg
                    focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition duration-200">
            </div>

            <div class="transition-all duration-300 hover:scale-[1.01]">
                <label for="photo" class="block text-gray-700 font-semibold mb-2">
                  Photo <% if (editing) { %><span class="text-sm font-normal text-gray-400">(leave empty to keep current photo)</span><% } %>
                </label>
                <input type="file" name="photo" id="photo"
                  accept="image/jpg, image/jpeg, image/png"
                    class="block w-full text-sm text-gray-500
                    file:mr-4 file:py-3 file:px-6
                    file:rounded-lg file:border-0
                    file:text-sm file:font-semibold
                    file:bg-blue-50 file:text-blue-600
                    hover:file:bg-blue-100
                    border rounded-lg cursor-pointer
                    focus:outline-none focus:ring-2 focus:ring-blue-400 transition duration-200">
            </div>

            <div class="transition-all duration-300 hover:scale-[1.01]">
                <label for="homescol" class="block text-gray-700 font-semibold mb-2">Description:</label>
                <textarea name="homescol" id="homescol" required rows="3"
                    placeholder="Describe your home" class="w-full px-5 py-3 border border-gray-200 rounded-lg
                    focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition duration-200"><%= editing ? home.homescol : '' %></textarea>
            </div>

            <div class="text-center pt-4">
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-3 rounded-lg
                    shadow-lg transition duration-300 ease-in-out transform hover:-translate-y-1 hover:shadow-xl">
                    <%= editing ? "Update Home" : "Add Home" %>
                </button>
            </div>
        </form>
    </div>
</body>
</html>
