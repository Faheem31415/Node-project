<%- include('partials/head') %>

<body class="bg-gradient-to-br from-slate-900 via-slate-950 to-black text-white w-full min-h-screen flex flex-col items-center justify-center px-6 text-center">

  <div class="max-w-xl">
    <h1 class="text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-500 drop-shadow-lg mb-4">
      <%= statusCode || 'Error' %>
    </h1>

    <h2 class="text-2xl md:text-3xl font-semibold text-gray-200 mb-4">
      <%= statusCode === 404 ? 'Page Not Found' : 'Something Went Wrong' %>
    </h2>

    <p class="text-md md:text-lg text-gray-400 mb-8">
      <%= message || "An unexpected error occurred. Please try again." %>
    </p>

    <a href="/" class="inline-block bg-purple-600 hover:bg-purple-700 text-white font-medium px-6 py-3 rounded-xl shadow-md transition duration-300 ease-in-out">
      ⬅️ Return to Homepage
    </a>
  </div>

</body>
</html>
