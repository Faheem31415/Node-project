<script src="https://unpkg.com/lucide@latest"></script>

<nav class="bg-slate-900 text-white p-4 shadow-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="text-2xl font-bold tracking-tight text-indigo-400 hover:text-white transition duration-200">
      Airbnb
    </a>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="menu-toggle"
      class="md:hidden p-2 rounded-md hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-400"
    >
      <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Navigation Links -->
    <div id="menu" class="w-full md:flex md:items-center md:w-auto hidden flex-col md:flex-row md:gap-2 gap-4 mt-4 md:mt-0">

      <!-- If logged in and user is a guest -->
       <% if (isLogin) { %>
      <% if (user && user.UserType === 'guest') { %>
        <a href="/user/homes-list" class="flex items-center px-4 py-2 rounded-md hover:bg-slate-800 hover:text-indigo-400 transition duration-200">
          <i data-lucide="home" class="w-5 h-5 mr-2"></i> Homes
        </a>

        <a href="/user/favourites" class="flex items-center px-4 py-2 rounded-md hover:bg-slate-800 hover:text-indigo-400 transition duration-200">
          <i data-lucide="heart" class="w-5 h-5 mr-2"></i> Favourites
        </a>

        <a href="/user/home-bookings" class="flex items-center px-4 py-2 rounded-md hover:bg-slate-800 hover:text-indigo-400 transition duration-200">
          <i data-lucide="calendar" class="w-5 h-5 mr-2"></i> Bookings
        </a>

      <!-- If logged in and user is a host -->
      <% } else  { %>
        <a href="/host/added-home" class="flex items-center px-4 py-2 rounded-md hover:bg-slate-800 hover:text-indigo-400 transition duration-200">
          <i data-lucide="building" class="w-5 h-5 mr-2"></i> Host Homes
        </a>

        <a href="/host/register-home" class="flex items-center px-4 py-2 rounded-md hover:bg-slate-800 hover:text-indigo-400 transition duration-200">
          <i data-lucide="plus-square" class="w-5 h-5 mr-2"></i> Add Home
        </a>
      <% } %>
<% } %>
      <!-- Auth Buttons -->
      <% if (!isLogin) { %>
        <a href="/login" class="flex items-center px-4 py-2 rounded-md bg-green-600 hover:bg-green-700 text-white font-medium transition duration-200">
          <i data-lucide="log-in" class="w-5 h-5 mr-2"></i> Login
        </a>

        <a href="/signup" class="flex items-center px-4 py-2 rounded-md bg-blue-600 hover:bg-blue-700 text-white font-medium transition duration-200">
          <i data-lucide="user-plus" class="w-5 h-5 mr-2"></i> Sign Up
        </a>
      <% } else { %>
        <form action="/logout" method="POST">
          <button type="submit" class="flex items-center px-4 py-2 rounded-md bg-red-600 hover:bg-red-700 text-white font-medium transition duration-200">
            <i data-lucide="log-out" class="w-5 h-5 mr-2"></i> Logout
          </button>
        </form>
      <% } %>

    </div>
  </div>

  <script>
    lucide.createIcons();

    document.getElementById("menu-toggle").addEventListener("click", () => {
      document.getElementById("menu").classList.toggle("hidden");
    });
  </script>
</nav>
