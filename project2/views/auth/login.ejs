<%- include('../partials/head') %>

<body class="bg-gray-100 min-h-screen font-sans">
  <%- include('../partials/header') %>

  <div class="max-w-xl mx-auto mt-10 p-8 bg-white shadow-lg rounded-xl">
    <h1 class="text-3xl font-bold text-center mb-8 text-gray-800">
      Login To Home Hub
    </h1>

    <form action="/login" method="POST" class="space-y-6">
       <%- include('../partials/errors') %>
      <div>
        <label for="homename" class="block text-gray-700 font-medium mb-1"
          >Email:</label
        >
        <input
          type="email"
          name="email"
          value="<%= oldInput ? oldInput.email : '' %>"
          required
          placeholder="Enter Your Email"
          class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div>
        <label for="location" class="block text-gray-700 font-medium mb-1"
          >Password:</label
        >
        <input
          type="password"
          name="password"
          id="location"
          placeholder="Enter Your Password"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div class="w-full flex justify-center">
        <button class="px-4 py-2 bg-slate-800 text-white rounded-2xl font-semibold hover:bg-slate-900" type="submit">Login</button>
      </div>
    </form>
  </div>
</body>
