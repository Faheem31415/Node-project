<%- include('../partials/head') %>

<body class="bg-gray-50 min-h-screen font-sans">
  <%- include('../partials/header') %>

  <div class="max-w-lg mx-auto mt-12 p-10 bg-white shadow-md rounded-lg">
    <h1 class="text-4xl font-extrabold text-center mb-6 text-gray-900">
      Create an Account
    </h1>

    <form action="/signup" method="POST" class="space-y-6">
      <%- include('../partials/errors') %>

      <div>
        <label for="firstname" class="block text-sm font-medium text-gray-700">First Name</label>
        <input
          type="text"
          name="firstname"
          id="firstname"
          required
          placeholder="John"
          value="<%= oldInput ? oldInput.firstname : '' %>"
          class="mt-1 block w-full px-4 py-2 border rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 <%= errors && errors.find(e => e.param === 'firstname') ? 'border-red-500' : 'border-gray-300' %>"
        />
      </div>

      <div>
        <label for="lastname" class="block text-sm font-medium text-gray-700">Last Name</label>
        <input
          type="text"
          name="lastname"
          id="lastname"
          placeholder="Doe"
          value="<%= oldInput ? oldInput.lastname : '' %>"
          class="mt-1 block w-full px-4 py-2 border rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 <%= errors && errors.find(e => e.param === 'lastname') ? 'border-red-500' : 'border-gray-300' %>"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
        <input
          type="email"
          name="email"
          id="email"
          placeholder="you@example.com"
          required
          value="<%= oldInput ? oldInput.email : '' %>"
          class="mt-1 block w-full px-4 py-2 border rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 <%= errors && errors.find(e => e.param === 'email') ? 'border-red-500' : 'border-gray-300' %>"
        />
      </div>

      <div>
        <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          placeholder="••••••••"
          required
          class="mt-1 block w-full px-4 py-2 border rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 <%= errors && errors.find(e => e.param === 'password') ? 'border-red-500' : 'border-gray-300' %>"
        />
      </div>

      <div>
        <label for="confirmPassword" class="block text-sm font-medium text-gray-700">Confirm Password</label>
        <input
          type="password"
          name="confirmPassword"
          id="confirmPassword"
          placeholder="••••••••"
          required
          class="mt-1 block w-full px-4 py-2 border rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 <%= errors && errors.find(e => e.param === 'confirmPassword') ? 'border-red-500' : 'border-gray-300' %>"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">User Type</label>
        <div class="flex items-center space-x-6">
          <div class="flex items-center">
            <input
              type="radio"
              name="UserType"
              id="guest"
              value="guest"
              required
              <%= oldInput && oldInput.UserType === 'guest' ? 'checked' : '' %>
              class="h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500"
            />
            <label for="guest" class="ml-2 text-sm text-gray-700">Guest</label>
          </div>
          <div class="flex items-center">
            <input
              type="radio"
              name="UserType"
              id="host"
              value="host"
              required
              <%= oldInput && oldInput.UserType === 'host' ? 'checked' : '' %>
              class="h-4 w-4 text-blue-600 border-gray-300 focus:ring-blue-500"
            />
            <label for="host" class="ml-2 text-sm text-gray-700">Host</label>
          </div>
        </div>
      </div>

      <div class="flex items-start">
        <div class="flex items-center h-5">
          <input
            id="terms"
            name="terms"
            type="checkbox"
            required
            <%= oldInput && oldInput.terms ? 'checked' : '' %>
            class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
          />
        </div>
        <div class="ml-3 text-sm">
          <label for="terms" class="text-gray-700">
            I agree to the
            <a href="#" class="text-blue-600 hover:underline">terms and conditions</a>.
          </label>
        </div>
      </div>

      <div class="w-full flex justify-center">
        <button
          class="w-full px-4 py-2 bg-blue-600 text-white rounded-md font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition duration-150"
          type="submit"
        >
          Register
        </button>
      </div>
    </form>
  </div>
</body>
