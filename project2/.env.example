# Server
PORT=5000

# MongoDB
MONGO_URI=your_mongodb_connection_string

# Session
SESSION_SECRET=a_very_long_random_and_secret_key_change_me_in_production

# ── AWS S3 (required for S3 uploads; omit to use local disk fallback) ───────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=xxxxxxx-xxxxx-xxxx
AWS_BUCKET_NAME=your_s3_bucket_name
