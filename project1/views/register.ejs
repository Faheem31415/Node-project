<%- include('partials/head') %>

<body class="bg-gray-100 min-h-screen font-sans">
    <%- include('partials/header') %>

    <div class="max-w-xl mx-auto mt-10 p-8 bg-white shadow-lg rounded-xl">
        <h1 class="text-3xl font-bold text-center mb-8 text-gray-800">Add your home to Airbnb</h1>

        <form action="/registered-home" method="POST" class="space-y-6">
            <div>
                <label for="name" class="block text-gray-700 font-medium mb-1">Name:</label>
                <input type="text" name="name" id="name" placeholder="Enter your name"
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label for="location" class="block text-gray-700 font-medium mb-1">Location:</label>
                <input type="text" name="location" id="location" placeholder="Enter location"
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label for="price" class="block text-gray-700 font-medium mb-1">Price:</label>
                <input type="number" name="price" id="price"
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label for="image" class="block text-gray-700 font-medium mb-1">Add Image url:</label>
                <input type="text" name="image" id="image"
                    class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div class="text-center">
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg shadow-md transition duration-300">
                    Add
                </button>
            </div>
        </form>
    </div>
</body>
