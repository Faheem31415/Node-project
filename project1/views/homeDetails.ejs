<%- include('partials/head') %>

<body class="w-full min-h-screen bg-gray-100 text-gray-800">
    <%- include('partials/header') %>

    <main class="max-w-5xl mx-auto p-6 mt-10 bg-white rounded-2xl shadow-lg">
        <h1 class="text-4xl font-bold mb-6 text-center">Home Details</h1>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
            <!-- Image Section -->
            <div>
                <img src="<%= home.image %>" alt="<%= home.name %>" class="w-full h-auto rounded-xl shadow-md object-cover">
            </div>

            <!-- Info Section -->
            <div class="space-y-6">
                <h2 class="text-3xl font-semibold"><%= home.name %></h2>
                <p class="text-xl"><span class="font-bold">Price:</span> $<%= home.price %></p>
                <p class="text-xl"><span class="font-bold">Location:</span> <%= home.location %></p>
            </div>
        </div>
    </main>
</body>
